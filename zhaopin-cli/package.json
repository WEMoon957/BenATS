{
  "name": "@wemoon/zhaopin-cli",
  "version": "0.1.0",
  "description": "智联招聘自动化 CLI：职位切换、候选人读取、详情抓取与打招呼。基于 Puppeteer/CDP 驱动本机 Chrome，供 Talent Hub 以子进程方式调用",
  "keywords": [
    "zhaopin",
    "智联招聘",
    "招聘自动化",
    "hr-automation",
    "recruitment-automation",
    "puppeteer",
    "cdp",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WEMoon957/BenATS.git",
    "directory": "zhaopin-cli"
  },
  "homepage": "https://github.com/WEMoon957/BenATS/tree/main/zhaopin-cli",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "zhaopin": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "HR使用说明.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "dev": "npm run build && node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "puppeteer-core": "^24.29.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.3.3"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
